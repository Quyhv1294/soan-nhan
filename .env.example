# Sao chép thành .env.local. File mẫu luôn để trống mọi khóa bí mật.

# Supabase: cần cho đăng nhập, quota tài khoản và lưu trực tuyến.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI: chỉ hỗ trợ Google Gemini. Khóa chỉ đặt ở máy chủ, không thêm NEXT_PUBLIC_.
AI_PROVIDER=google
AI_API_KEY=
# Để trống để dùng mặc định trong src/lib/ai.ts, hoặc điền ID mô hình đang có.
AI_MODEL_FAST=
AI_MODEL_STRONG=

# Hai giá trị quota cần giống nhau.
FREE_GENERATIONS_PER_MONTH=20
NEXT_PUBLIC_FREE_GENERATIONS_PER_MONTH=20

# Máy cá nhân có thể đặt Chrome/Edge. Vercel dùng Chromium đóng gói nếu đã cài.
CHROME_PATH=
